<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Plain output: logs go to docker logs, where colour codes are just noise -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- The root level is overridden at startup by "loglevel" in config.txt -->
    <root level="info">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
